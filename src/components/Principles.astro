---
import Section from "@/components/Section.astro";
import { site } from "@/lib/site";
const { principles } = site;
---

<Section id="principles" number={principles.sectionNumber} label={principles.sectionLabel}>
  <ul class="grid gap-5 sm:grid-cols-2">
    {
      /* No card numbers: they used the same mono/accent treatment as the section
         rail numbers, so "04" appeared twice on screen meaning two things. */
      principles.items.map((item) => (
        <li class="neu-card flex flex-col gap-3 p-6 md:p-7">
          <h3 class="display text-xl font-semibold text-foreground">
            <span class="mr-2 text-accent" aria-hidden="true">/</span>{item.title}
          </h3>
          <p class="text-[0.9375rem] leading-relaxed text-muted-foreground">{item.body}</p>
        </li>
      ))
    }
  </ul>
</Section>
