---
/*
 * Moves the light every neumorphic surface is lit by.
 *
 * The whole page shares one direction — a sun, not 55 lamps — carried in the
 * `--lx` / `--ly` pair that `global.css` multiplies into every shadow offset.
 * That is the entire coupling: this component writes two numbers, and every
 * raised, inset and flat surface follows.
 *
 * Nothing here changes contrast. The vector's magnitude is pinned, so only the
 * direction of depth moves, never its amount.
 */
import { site } from "@/lib/site";

const { permissionPrimer } = site.lightSource;
---

{/* Only ever opened on the permission-gated path — iOS Safari — so it stays
    display:none everywhere else. The panel is a child rather than the dialog
    itself so a tap on the backdrop is distinguishable from a tap on the card's
    padding, which is how light dismissal stays honest. */}
<dialog id="tilt-primer" class="tilt-primer" aria-labelledby="tilt-primer-title">
  <div class="neu-card p-6">
    <h2 id="tilt-primer-title" class="display text-lg font-semibold text-foreground">
      {permissionPrimer.title}
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{permissionPrimer.body}</p>
    <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <button id="tilt-primer-cancel" type="button" class="neu-btn">{permissionPrimer.cancel}</button>
      <button id="tilt-primer-confirm" type="button" class="neu-btn-primary">
        {permissionPrimer.confirm}
      </button>
    </div>
  </div>
</dialog>

<script>
  function initLightSource() {
    const root = document.documentElement;

    // Rest state (1, 1) is the fixed top-left light the design shipped with.
    // Everything below is a rotation of a vector with this magnitude.
    const REST = Math.SQRT2;
    // Below this the shadow change is invisible, so writing it is pure cost.
    const EPSILON = 0.004;
    const EASE = 0.12;
    // Degrees of phone tilt that map to the full horizontal swing.
    const TILT_RANGE = 32;
    /* Both inputs land on the same mapping: a horizontal term and a vertical one
       composed against a small constant bias. The bias only exists to give the
       neutral input — cursor at the centre, phone held flat — a stable answer of
       "light directly above" instead of a degenerate atan2(0, 0). It is kept well
       under the vertical swing so the light still travels the full circle and can
       genuinely come from below. */
    const OVERHEAD_BIAS = 0.35;
    const HORIZONTAL_SWING = 1.15;
    const VERTICAL_SWING = 1.05;
    /* Activation cue. Tapping the control while holding the phone still shows
       nothing at all otherwise — the effect is real but only visible once you
       happen to tilt. So the light takes one full turn around the page and comes
       back to rest, which demonstrates the whole range the mode just handed to
       the phone instead of decorating the fact that something changed. It is a
       rotation like any other, so the pinned magnitude is untouched: the amount
       of depth never moves, only where it points. Long enough that the half-turn
       through the bottom — where every raised surface reads as a recess — is a
       legible pass rather than a flicker. */
    const CUE_DURATION = 1000;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // The (1, 1) the design ships with, as an angle.
    const REST_ANGLE = Math.PI / 4;

    let targetAngle = REST_ANGLE;
    let currentAngle = targetAngle;
    let lastX: number | null = null;
    let lastY: number | null = null;
    let running = false;
    let tilting = false;

    /* The light travels the full circle. Nothing constrains it to the upper half:
       lit from below, a raised surface reads as a recess and the depth flips.
       That inversion is deliberate — it is the most legible sign that the light
       is really being steered, and it was preferred over the safer clamped
       version when the two were compared side by side. Magnitude is constant, so
       the amount of depth never changes even as its direction does. */
    function vectorFor(angle: number): [number, number] {
      return [Math.cos(angle) * REST, Math.sin(angle) * REST];
    }

    function frame(now: number) {
      let delta = 0;

      if (cueStart === null) {
        delta = targetAngle - currentAngle;
        // Always rotate the short way round, so a light crossing the top of the
        // screen does not unwind the long way through the bottom.
        while (delta > Math.PI) delta -= 2 * Math.PI;
        while (delta < -Math.PI) delta += 2 * Math.PI;
        currentAngle += delta * EASE;
      } else {
        /* The cue cannot be expressed as a target, because the short-way-round
           rule above is exactly what a full turn defeats: one revolution from
           rest normalises to a delta of zero and the light would not move at
           all. So it is driven straight off the clock, eased in and out so the
           revolution reads as one deliberate movement rather than a constant
           sweep, and the angle is handed back the moment it completes. */
        const t = Math.min(1, (now - cueStart) / CUE_DURATION);
        const eased = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(2 - 2 * t, 3) / 2;
        currentAngle = REST_ANGLE + eased * 2 * Math.PI;
        if (t === 1) {
          // A full turn lands back on rest. Say so, rather than leaving the
          // angle 2π out and every later delta to unwind it.
          currentAngle = REST_ANGLE;
          endCue(true);
        }
      }

      const [x, y] = vectorFor(currentAngle);
      const moved = lastX === null || Math.abs(x - lastX) > EPSILON || Math.abs(y - lastY!) > EPSILON;

      if (moved) {
        root.style.setProperty("--lx", x.toFixed(3));
        root.style.setProperty("--ly", y.toFixed(3));
        lastX = x;
        lastY = y;
      }

      // Stop scheduling once the light has settled. An idle page costs nothing,
      // which is what makes the tilt mode viable on a phone held still. The cue
      // holds the loop open on its own: eased, its first and last frames move
      // less than EPSILON and would otherwise read as settled.
      if (cueStart !== null || Math.abs(delta) > 0.0005 || moved) {
        requestAnimationFrame(frame);
      } else {
        running = false;
      }
    }

    function wake() {
      if (running || reduceMotion.matches || document.hidden) return;
      running = true;
      requestAnimationFrame(frame);
    }

    /* `horizontal` is positive when the light should come from the left, so the
       dark shadow falls to the right. `vertical` is positive when it should come
       from higher up. Both are expected in roughly -1..1. */
    function aim(horizontal: number, vertical: number) {
      targetAngle = Math.atan2(
        OVERHEAD_BIAS + vertical * VERTICAL_SWING,
        horizontal * HORIZONTAL_SWING,
      );
      wake();
    }

    function aimAt(clientX: number, clientY: number) {
      const clamp = (n: number) => Math.max(-1, Math.min(1, n));
      aim(
        clamp((window.innerWidth / 2 - clientX) / (window.innerWidth / 2)),
        clamp((window.innerHeight / 2 - clientY) / (window.innerHeight / 2)),
      );
    }

    function rest() {
      targetAngle = REST_ANGLE;
      wake();
    }

    /* ---- pointer ---- */

    window.addEventListener(
      "pointermove",
      (event) => {
        // A finger dragging the page should not fight the tilt mapping.
        if (tilting || event.pointerType === "touch") return;
        aimAt(event.clientX, event.clientY);
      },
      { passive: true },
    );

    // Losing the cursor should return the light home rather than freeze it
    // wherever the pointer happened to leave.
    document.addEventListener("pointerleave", () => {
      if (!tilting) rest();
    });

    /* ---- device tilt ---- */

    const button = document.getElementById("tilt-toggle");
    const DeviceOrientation = window.DeviceOrientationEvent as
      | (typeof window.DeviceOrientationEvent & { requestPermission?: () => Promise<string> })
      | undefined;
    const needsPermission = typeof DeviceOrientation?.requestPermission === "function";
    // Desktop Chrome defines DeviceOrientationEvent, so its presence proves
    // nothing on its own. Require a real sensor gate: iOS's permission API, or
    // a device that at least claims a coarse pointer.
    // Reduced motion pins the light, so tilting could not do anything. Offering
    // the control anyway would be the same dead button as on Brave.
    const mayHaveSensor =
      Boolean(DeviceOrientation) &&
      !reduceMotion.matches &&
      (needsPermission || window.matchMedia("(pointer: coarse)").matches);

    /* Android is uneven here. Plenty of devices never fire `deviceorientation`
       at all — it wants a gyroscope — but do fire `deviceorientationabsolute`,
       which is derived from the magnetometer. Subscribe to both to find out
       which one this device delivers, then keep only that one: Android Chrome
       fires both, and two live subscriptions drive one light from two
       interleaved streams on a last-writer-wins basis. */
    const ORIENTATION_EVENTS = ["deviceorientation", "deviceorientationabsolute"];
    // If nothing usable has arrived by now, no sensor is coming.
    const SENSOR_TIMEOUT = 1500;
    // How long the silent probe waits for proof of a live sensor before giving up.
    const PROBE_TIMEOUT = 2000;

    // Both axes share one zero: the pose the phone was actually in when tilting
    // started. Calibrating only beta left the two axes measuring from different
    // origins, which shows up the moment the screen rotates and the matrix below
    // starts mixing them.
    let restPose: { beta: number; gamma: number } | null = null;
    let boundEvent: string | null = null;
    let sensorSeen = false;
    let watchdog = 0;
    let cueStart: number | null = null;

    function endCue(settle: boolean) {
      cueStart = null;
      // Nothing to hand the light over to until a reading arrives, so it goes
      // back to exactly where the static design has it.
      if (settle) rest();
    }

    function playCue() {
      // Shares its time origin with the timestamp rAF passes to frame().
      cueStart = performance.now();
      wake();
    }

    /* The first real reading owns the session. Dropping the other subscription
       is what makes the axis convention a property of one known source instead
       of whichever event fired last. */
    function bindTo(name: string) {
      boundEvent = name;
      for (const other of ORIENTATION_EVENTS) {
        if (other !== name) window.removeEventListener(other, onOrientation as EventListener);
      }
    }

    function onOrientation(event: DeviceOrientationEvent) {
      // A browser can deliver the event with every field null — Brave's
      // fingerprinting shield does exactly this. That is a dead sensor, not a
      // reading, so it must not count as proof of life.
      if (event.beta === null && event.gamma === null) return;
      if (boundEvent === null) bindTo(event.type);
      // A reading from the losing stream, already dispatched when it was dropped.
      if (event.type !== boundEvent) return;
      sensorSeen = true;
      if (restPose === null) restPose = { beta: event.beta ?? 45, gamma: event.gamma ?? 0 };
      // The cue owns the light for its brief run. A live stream arrives on the
      // next frame and would otherwise erase it before anyone saw it. Calibration
      // happens first regardless, so the pose is the one the phone was in at the
      // tap and not wherever it has drifted to a second later.
      if (cueStart !== null) return;

      const gamma = (event.gamma ?? 0) - restPose.gamma;
      const beta = (event.beta ?? 45) - restPose.beta;

      /* Both angles are right-handed about the device's own axes, so `beta > 0`
         raises the top edge but `gamma > 0` raises the *left* edge: the two axes
         disagree about which way points up the slope. Lighting from the raised
         edge therefore mirrors the horizontal term and not the vertical one, and
         a mirror on each side of the screen-rotation matrix is that rotation
         inverted. So undoing the screen rotation and pointing the light uphill
         are the same single rotation, by the negative of the screen angle.

         The sign is not a constant hung off the end of the mapping — it belongs
         to the rotation. Pinning it there is what let portrait and landscape
         disagree, since at 0° the matrix is the identity and hides it. */
      const unrotate = -((screen.orientation && screen.orientation.angle) || 0) * (Math.PI / 180);
      const gx = gamma * Math.cos(unrotate) - beta * Math.sin(unrotate);
      const gy = gamma * Math.sin(unrotate) + beta * Math.cos(unrotate);

      const nx = Math.max(-1, Math.min(1, gx / TILT_RANGE));
      const ny = Math.max(-1, Math.min(1, gy / TILT_RANGE));

      // Held at the calibrated pose both terms are zero, which lands on the same
      // overhead neutral the pointer path uses at the centre of the screen.
      aim(nx, ny);
    }

    function listen(on: boolean) {
      for (const name of ORIENTATION_EVENTS) {
        // Before discovery, subscribe to both; after it, only to the winner.
        if (on && (boundEvent === null || boundEvent === name)) {
          window.addEventListener(name, onOrientation as EventListener);
        } else {
          window.removeEventListener(name, onOrientation as EventListener);
        }
      }
    }

    function setTilting(on: boolean) {
      tilting = on;
      button?.setAttribute("aria-pressed", String(on));
      button?.setAttribute("aria-label", on ? "Stop steering the light by tilting" : "Steer the light by tilting");
      if (on) {
        playCue();
      } else {
        endCue(false);
        listen(false);
        restPose = null;
        rest();
      }
    }

    /* A button that latches on while nothing moves is worse than no button. If
       the sensor never reports, say so on the control itself rather than leaving
       it looking enabled. */
    function markUnavailable() {
      window.clearTimeout(watchdog);
      endCue(false);
      listen(false);
      tilting = false;
      restPose = null;
      if (button) {
        const reason = "Motion sensor unavailable in this browser";
        button.setAttribute("aria-pressed", "false");
        button.setAttribute("aria-disabled", "true");
        button.setAttribute("aria-label", reason);
        button.setAttribute("title", reason);
        button.dataset.sensor = "unavailable";
      }
      rest();
    }

    /* Reveal the control only once we know it can do something.

       On Chromium the sensor streams without any permission, so we can subscribe
       quietly on load and wait for one real reading before showing anything.
       Brave's fingerprinting shield never produces one — by design, it treats
       motion as a tracking vector — so on Brave the button simply never appears
       rather than appearing and refusing to work.

       iOS is the exception: readings are gated behind a permission that can only
       be requested from inside a user gesture, so there is nothing to probe until
       the user has already tapped. There the control has to appear on faith, and
       the watchdog is what catches a refusal. */
    function reveal() {
      button?.classList.remove("hidden");
    }

    function probeForSensor() {
      let settled = false;
      const finish = (found: boolean) => {
        if (settled) return;
        settled = true;
        window.clearTimeout(timer);
        for (const name of ORIENTATION_EVENTS) {
          window.removeEventListener(name, onProbe as EventListener);
        }
        if (found) reveal();
      };
      const onProbe = (event: DeviceOrientationEvent) => {
        if (event.beta === null && event.gamma === null) return;
        // The probe is the discovery pass: the source that proves the sensor is
        // the one that will drive it, so tilting never has to re-race the two.
        bindTo(event.type);
        finish(true);
      };
      for (const name of ORIENTATION_EVENTS) {
        window.addEventListener(name, onProbe as EventListener);
      }
      const timer = window.setTimeout(() => finish(false), PROBE_TIMEOUT);
    }

    function startTilting() {
      sensorSeen = false;
      listen(true);
      setTilting(true);
      window.clearTimeout(watchdog);
      watchdog = window.setTimeout(() => {
        if (!sensorSeen) markUnavailable();
      }, SENSOR_TIMEOUT);
    }

    /* Must be called synchronously from a tap. iOS only grants this from inside
       a user gesture, which is the whole reason this is a button and not an
       automatic upgrade — and the reason the promise is handled with .then()
       rather than awaited by the caller. An await before the call is what loses
       the gesture and gets the request rejected with no prompt ever shown. */
    function requestMotionAccess() {
      let request: Promise<string>;
      try {
        request = DeviceOrientation!.requestPermission!();
      } catch {
        return markUnavailable();
      }
      request
        .then((result) => (result === "granted" ? startTilting() : markUnavailable()))
        .catch(() => markUnavailable());
    }

    /* ---- the primer ---- */

    /* A cold system dialog asking for motion access is easy to deny by reflex,
       and a denial is final. So on the permission-gated path the ask is
       explained first, and the grant is requested from the confirm tap.

       Deliberately remembered for the page load only, not in localStorage: iOS
       may or may not re-prompt on a later visit and there is no way to ask which,
       so a remembered grant would sometimes skip the explanation and let the cold
       prompt through — precisely what this exists to prevent. Within one load the
       answer is known, so toggling tilt off and on again does not re-explain. */
    const primer = document.getElementById("tilt-primer") as HTMLDialogElement | null;
    // Pre-15.4 Safari has no showModal(); there the ask stays as direct as it was.
    const canPrime = typeof primer?.showModal === "function";
    let explained = false;

    // Wired up on the permission-gated path only. Everywhere else — Chromium,
    // Brave, reduced motion — the dialog is inert markup nothing can reach.
    if (primer && canPrime && button && mayHaveSensor && needsPermission) {
      document.getElementById("tilt-primer-confirm")?.addEventListener("click", () => {
        explained = true;
        // Nothing may be awaited between this tap and the request.
        requestMotionAccess();
        primer.close();
      });

      document.getElementById("tilt-primer-cancel")?.addEventListener("click", () => primer.close());

      // Tapping past a panel is the first gesture anyone tries on a phone. Only
      // the backdrop is the dialog itself; the card is a child.
      primer.addEventListener("click", (event) => {
        if (event.target === primer) primer.close();
      });

      /* Backing out is not a denial: the control is left exactly as it was —
         off, enabled, and holding the focus the tap came from. Safari does not
         focus a button on click, so there is often nothing for the dialog to
         restore focus to on its own. */
      primer.addEventListener("close", () => {
        if (explained) button.removeAttribute("aria-haspopup");
        button.focus();
      });
    }

    if (button && mayHaveSensor) {
      if (needsPermission) reveal();
      else probeForSensor();

      if (needsPermission && canPrime) button.setAttribute("aria-haspopup", "dialog");

      button.addEventListener("click", () => {
        if (button.getAttribute("aria-disabled") === "true") return;
        if (tilting) return setTilting(false);
        if (!needsPermission) return startTilting();
        if (canPrime && !explained) return primer!.showModal();
        requestMotionAccess();
      });
    }

    /* ---- restraint ---- */

    reduceMotion.addEventListener("change", () => {
      if (!reduceMotion.matches) return;
      // Switched on mid-session: stop tilting, take the control away, and put
      // the light back where the static design has it. The primer goes with the
      // control — it must never be reachable once tilting cannot do anything.
      if (tilting) setTilting(false);
      if (primer?.open) primer.close();
      button?.classList.add("hidden");
      root.style.removeProperty("--lx");
      root.style.removeProperty("--ly");
      lastX = null;
      lastY = null;
      currentAngle = targetAngle = REST_ANGLE;
    });

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) wake();
    });
  }

  initLightSource();
</script>

<style>
  /* Native <dialog> earns the top layer, the backdrop, the focus trap and
     Escape without a line of script. Here it is only the frame: the card is a
     child, so `overflow: visible` is what keeps the neumorphic shadow from
     being clipped off at the frame's edge. */
  .tilt-primer {
    width: min(24rem, calc(100vw - 2rem));
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    color: var(--foreground);
  }
  /* Literal rather than a token: ::backdrop only inherits from its originating
     element in recent Safari, and this has to dim correctly before that. */
  .tilt-primer::backdrop {
    background: rgba(28, 25, 23, 0.5);
    backdrop-filter: blur(3px);
  }
  .tilt-primer[open] {
    animation: tilt-primer-in 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes tilt-primer-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
</style>
