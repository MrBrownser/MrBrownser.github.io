---
import { site } from "@/lib/site";

const links = [
  { href: "#about", label: "About" },
  { href: "#career", label: "Career" },
  { href: "#how-i-work", label: "How I work" },
  { href: "#principles", label: "Principles" },
  { href: "#contact", label: "Contact" },
];
const { brand } = site;
---

<a
  href="#main"
  class="sr-only rounded-xl bg-accent-solid px-4 py-2 text-sm font-semibold text-accent-solid-foreground focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100]"
>
  Skip to content
</a>

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
  data-scrolled="false"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4" aria-label="Main">
    <a href="#hero" class="display -m-2 p-2 text-lg font-semibold tracking-tight text-foreground">
      {brand.navInitials}<span class="text-accent">.</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link text-sm font-medium text-muted-foreground transition-colors hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      {/* Hidden until LightSource.astro confirms a real motion sensor. Desktop
          browsers define DeviceOrientationEvent without having one. */}
      <button
        id="tilt-toggle"
        class="neu-icon hidden h-11 w-11 text-foreground"
        aria-label="Steer the light by tilting"
        aria-pressed="false"
      >
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.2 3.4a.4.4 0 0 1 .77 0l1.25 4.32a2 2 0 0 0 1.37 1.37l4.32 1.25a.4.4 0 0 1 0 .77l-4.32 1.25a2 2 0 0 0-1.37 1.37l-1.25 4.32a.4.4 0 0 1-.77 0l-1.25-4.32a2 2 0 0 0-1.37-1.37L4.26 11.1a.4.4 0 0 1 0-.77l4.32-1.25a2 2 0 0 0 1.37-1.37z"></path><path d="M18.5 3v3M20 4.5h-3M5.5 17.5v2M6.5 18.5h-2"></path></svg>
      </button>

      <button id="theme-toggle" class="neu-icon h-11 w-11 text-foreground" aria-label="Toggle colour theme">
        <svg class="theme-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="theme-moon h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>

      <button
        id="mobile-menu-btn"
        class="neu-icon h-11 w-11 text-foreground md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="menu-bar menu-bar-top" d="M4 7h16"></path>
          <path class="menu-bar menu-bar-mid" d="M4 12h16"></path>
          <path class="menu-bar menu-bar-bottom" d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="md:hidden">
    {/* The padding is clearance, not symmetry. The panel needs `overflow: hidden`
        for its height transition, and tilt swings `--ly` to -1.414, so the card's
        shadow pair casts about 25px past whichever edge the light has moved
        behind. Against 0px of top padding the dark half was sliced off flat
        while the other three sides kept their falloff, which reads as a
        rendering glitch rather than as depth. 24px on every side leaves the
        shadow whole at any angle. `overflow: clip` with `overflow-clip-margin`
        is the precise tool and Safari does not have it yet. */}
    <div class="menu-panel p-6">
      <ul class="neu-card flex flex-col gap-1 p-2">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="mobile-link block rounded-lg px-4 py-3 text-sm font-medium text-foreground transition-colors hover:text-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  function initNav() {
    const root = document.documentElement;
    const header = document.getElementById("site-header");

    function paintThemeIcons() {
      const isDark = root.classList.contains("dark");
      document.querySelectorAll<HTMLElement>(".theme-sun").forEach((el) => el.classList.toggle("hidden", !isDark));
      document.querySelectorAll<HTMLElement>(".theme-moon").forEach((el) => el.classList.toggle("hidden", isDark));
    }

    function toggleTheme(event: Event) {
      const apply = () => {
        root.classList.toggle("dark");
        localStorage.setItem("theme", root.classList.contains("dark") ? "dark" : "light");
        paintThemeIcons();
      };

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced || !document.startViewTransition || !root.animate) {
        apply();
        return;
      }

      // Measure the button now, before the transition swaps anything out.
      const rect = (event.currentTarget as HTMLElement).getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      // Reach the corner furthest from the button so the wipe always completes.
      const radius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );

      const transition = document.startViewTransition(apply);

      // Animate the pseudo-element directly with real pixel values. Passing the
      // origin through CSS custom properties depends on them inheriting into the
      // view-transition pseudo tree, which is where the ripple lost its origin.
      transition.ready
        .then(() => {
          root.animate(
            {
              clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`],
            },
            {
              duration: 550,
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              pseudoElement: "::view-transition-new(root)",
            },
          );
        })
        .catch(() => {
          /* transition was skipped; the class swap already happened */
        });
    }

    document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);

    const menuBtn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const menuPanel = menu?.querySelector<HTMLElement>(".menu-panel");

    // The open state lives on the header, which already carries it for the
    // surface treatment. Everything else the panel and the icon do is CSS.
    const menuIsOpen = () => header?.getAttribute("data-menu-open") === "true";

    function setMenu(open: boolean) {
      // display:none cannot be transitioned, so the panel travels between zero
      // and a real height. Measured on each open so it follows the text size,
      // and only when it measures at all — above the md breakpoint the panel is
      // display:none and would report nothing to travel to.
      if (open && menu && menuPanel?.offsetHeight) {
        menu.style.setProperty("--menu-height", `${menuPanel.offsetHeight}px`);
      }
      // The header is transparent at the top of the page. An open menu needs
      // its own surface or it floats over the hero with nothing behind it.
      header?.setAttribute("data-menu-open", String(open));
      menuBtn?.setAttribute("aria-expanded", String(open));
      menuBtn?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    }

    menuBtn?.addEventListener("click", () => setMenu(!menuIsOpen()));
    menu?.querySelectorAll(".mobile-link").forEach((l) => l.addEventListener("click", () => setMenu(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setMenu(false);
    });

    // The panel covers most of a phone screen, so tapping past it is the first
    // gesture anyone tries. pointerdown fires once for both touch and mouse;
    // the button is left out of it so its own click still toggles rather than
    // reopening what the dismissal just closed.
    document.addEventListener("pointerdown", (e) => {
      if (!menuIsOpen()) return;
      const target = e.target as Node | null;
      if (menu?.contains(target) || menuBtn?.contains(target)) return;
      setMenu(false);
    });

    // A rotation while the panel is open would otherwise leave it clipped to a
    // height measured for the old width.
    window.addEventListener("resize", () => {
      if (menuIsOpen()) setMenu(true);
    });

    // Only give the header a surface once the page has actually scrolled,
    // so the hero stays a single uninterrupted plane.
    const onScroll = () => {
      const scrolled = window.scrollY > 24;
      header?.setAttribute("data-scrolled", String(scrolled));
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    // Highlight whichever section is currently in view.
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".nav-link")];
    const sections = navLinks
      .map((l) => document.querySelector(l.getAttribute("href") ?? ""))
      .filter((el): el is Element => Boolean(el));

    if (sections.length) {
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            navLinks.forEach((l) =>
              l.classList.toggle("is-active", l.getAttribute("href") === `#${entry.target.id}`),
            );
          });
        },
        { rootMargin: "-45% 0px -50% 0px" },
      );
      sections.forEach((s) => spy.observe(s));
    }

    paintThemeIcons();
  }

  initNav();
</script>

<style>
  #site-header[data-scrolled="true"],
  #site-header[data-menu-open="true"] {
    background-color: color-mix(in srgb, var(--background) 82%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--hairline);
  }
  .nav-link.is-active {
    color: var(--accent);
  }

  /* Collapsed rather than display:none, which is not animatable. visibility
     keeps the closed links out of the tab order and the accessibility tree,
     and transitions as a step so the panel stays on screen while it fades. */
  #mobile-menu {
    height: 0;
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    transition:
      height 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.16s ease-out,
      visibility 0.2s;
  }
  #site-header[data-menu-open="true"] #mobile-menu {
    height: var(--menu-height, auto);
    visibility: visible;
    opacity: 1;
  }
  .menu-panel {
    transform: translateY(-0.5rem);
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #site-header[data-menu-open="true"] .menu-panel {
    transform: none;
  }

  /* Three bars folding into two crossed ones. The origin is given in viewBox
     units so it stays the centre of the icon, not of each bar's own box. */
  .menu-bar {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition:
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.12s ease-out;
  }
  #mobile-menu-btn[aria-expanded="true"] .menu-bar-top {
    transform: rotate(45deg) translateY(5px);
  }
  #mobile-menu-btn[aria-expanded="true"] .menu-bar-mid {
    opacity: 0;
    transform: scaleX(0.4);
  }
  #mobile-menu-btn[aria-expanded="true"] .menu-bar-bottom {
    transform: rotate(-45deg) translateY(-5px);
  }
</style>
