---
import { Picture } from "astro:assets";
import { site } from "@/lib/site";
import portrait from "@/assets/profile.jpg";
const { hero } = site;
---

<section id="hero" class="relative flex min-h-[100svh] flex-col justify-center px-6 pb-20 pt-28" aria-label="Introduction">
  <div class="hero-stack mx-auto flex w-full max-w-4xl flex-col items-center gap-9 text-center">
    <div class="hero-plate neu-sm rounded-full p-2.5" style="background-color: var(--background)">
      <div class="hero-portrait relative overflow-hidden rounded-full">
        <Picture
          src={portrait}
          alt={hero.portraitAlt}
          formats={["avif", "webp"]}
          fallbackFormat="jpeg"
          widths={[112, 144, 224, 288, 432]}
          width={432}
          height={432}
          sizes="(min-width: 768px) 144px, 112px"
          class="h-28 w-28 rounded-full object-cover md:h-36 md:w-36"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="flex flex-col items-center gap-5">
      <h1 class="display text-balance text-[2.75rem] font-semibold leading-[1.02] text-foreground sm:text-6xl md:text-7xl">
        {hero.name}
      </h1>
      <p class="eyebrow !text-accent">{hero.tagline}</p>
      <p class="max-w-prose text-pretty text-base leading-relaxed text-muted-foreground md:text-lg">
        {hero.subtagline}
      </p>
    </div>

    <div class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row">
      <a href="#career" class="neu-btn-primary w-full sm:w-auto">{hero.primaryCta}</a>
      <a href="#contact" class="neu-btn w-full sm:w-auto">{hero.secondaryCta}</a>
    </div>

    <dl class="mt-2 flex flex-wrap items-center justify-center gap-x-7 gap-y-3">
      {
        hero.facts.map((fact) => (
          <div class="flex items-baseline gap-2">
            <dt class="eyebrow">{fact.label}</dt>
            <dd class="text-sm font-medium text-foreground">
              {fact.href ? (
                <a href={fact.href} target="_blank" rel="noopener noreferrer" class="inline-block py-1.5 underline decoration-hairline underline-offset-4 transition-colors hover:text-accent hover:decoration-accent">
                  {fact.value}
                </a>
              ) : (
                fact.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <a
    href="#about"
    class="scroll-cue neu-icon absolute bottom-8 left-1/2 h-11 w-11 -translate-x-1/2 text-muted-foreground hover:text-accent"
    aria-label="Scroll to the About section"
  >
    <svg class="h-4 w-4 motion-safe:animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M19 12l-7 7-7-7"></path>
    </svg>
  </a>
</section>

<style>
  /* An inset box-shadow paints behind child content, so the plate's inner rim
     needs its own layer to sit on top of the photo. */
  .hero-portrait::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    box-shadow: var(--neu-inset);
    pointer-events: none;
  }

  /* Short laptop windows: the hero must not push its own CTAs below the fold. */
  @media (max-height: 780px) and (min-width: 640px) {
    #hero {
      padding-top: 6rem;
      padding-bottom: 3rem;
    }
    .hero-stack {
      gap: 1.5rem;
    }
    .hero-plate img {
      height: 5rem;
      width: 5rem;
    }
    #hero h1 {
      font-size: 3.25rem;
    }
    .scroll-cue {
      display: none;
    }
  }
</style>
